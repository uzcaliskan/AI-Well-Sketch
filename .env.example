# Gizli bilgileri bu dosyaya değil, kendi ortam değişkenlerinize yazın. Bu dosya yalnızca şablondur.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Şirket içi vLLM (kararlar.md K-04). Hiçbir veri dış servise gönderilmez.
# OpenAI uyumlu uç nokta; vLLM'in --enable-auto-tool-choice ve uygun --tool-call-parser ile başlatılmış olması gerekir.
VLLM_BASE_URL=http://SUNUCU-IP:8000/v1
VLLM_MODEL=
VLLM_API_KEY=
VLLM_MAX_TOKENS=4096
VLLM_TIMEOUT=300
# Sunucu IP değil de alan adıyla veriliyorsa (örn. vllm.sirket.local) buraya yazın; genel internet adresleri reddedilir.
VLLM_IZINLI_HOSTLAR=
